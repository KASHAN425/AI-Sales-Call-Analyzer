# ==================================================
# ENVIRONMENT VARIABLES & API KEYS (CRITICAL - DO NOT COMMIT)
# ==================================================
.env
.env.*
*.env
backend/.env
frontend/.env

# ==================================================
# PYTHON VIRTUAL ENVIRONMENT & PACKAGES
# ==================================================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ==================================================
# PYTHON BYTECODE & CACHE
# ==================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/

# ==================================================
# UPLOADED AUDIO FILES & RUNTIME STORAGE
# ==================================================
uploads/*
!uploads/.gitkeep
jobs/*
!jobs/.gitkeep
output/*
!output/.gitkeep

# Ignore test audio files in root
*.mp3
*.wav
*.m4a
*.ogg
*.flac

# ==================================================
# LARGE ARCHIVES & LOCAL FFMPEG BINARIES
# ==================================================
ffmpeg-*.zip
ffmpeg-*.7z
ffmpeg-*/

# ==================================================
# OPERATING SYSTEM & IDE ARTIFACTS
# ==================================================
.DS_Store
Thumbs.db
project.md
Desktop.ini
.vscode/
.idea/
*.swp
*.swo

# ==================================================
# LOGS & TEMPORARY FILES
# ==================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
